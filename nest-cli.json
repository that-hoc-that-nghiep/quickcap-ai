{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            {
                "include": "../public",
                "exclude": "../public/model/**/*",
                "outDir": "dist/public"
            }
        ],
        "watchAssets": true
    }
}
